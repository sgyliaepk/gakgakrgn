local function updateTarget()
    targetPlayer = nil

    local name = targetInput.Text:lower()

    if name == "" then
        createNotification("Error", "Enter a username")
        return
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then
            if p.Name:lower():sub(1, #name) == name then
                targetPlayer = p

                -- Enable target mode automatically
                targetMode = true

                if targetToggle then
                    targetToggle.Text = "TARGET MODE: ON"
                end

                createNotification("Target Locked", p.Name)
                return
            end
        end
    end

    createNotification("Error", "Player not found")
end




local function setupWalkFlingLogic(): ()
    local flingConnection = RunService.PostSimulation:Connect(function()
    if not playerState.isWalkFlingActive then return end
    

        if flingToggle then
    flingToggle.BackgroundColor3 = Color3.fromHSV(tick() % 3 / 3, 0.6, 0.8)
end

        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                for _, part in pairs(p.Character:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end

        if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = player.Character.HumanoidRootPart
        
        local powerPercent = tonumber(powerInput.Text) or CONFIG.DEFAULT_FLING_POWER
        powerPercent = clampPower(powerPercent)
        if powerPercent <= 0 then return end
        
        local strength = powerPercent * 5000

        local targetNearby = false

if targetMode then

    if not targetPlayer then
        return
    end

    if targetPlayer.Character then
        local targetHRP = targetPlayer.Character:FindFirstChild("HumanoidRootPart")

        if targetHRP then
            local distance = (hrp.Position - targetHRP.Position).Magnitude

            if distance <= CONFIG.FLING_RADIUS then
                targetNearby = true
            end
        end
    end

else

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local targetHRP = p.Character:FindFirstChild("HumanoidRootPart")

            if targetHRP then
                local distance = (hrp.Position - targetHRP.Position).Magnitude

                if distance <= CONFIG.FLING_RADIUS then
                    targetNearby = true
                    break
                end
            end
        end
    end

end

        if targetNearby then
            for _, v in pairs(player.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = false end
            end
            
            local oldV = hrp.Velocity
            hrp.Velocity = Vector3.new(strength, strength, strength)
            RunService.RenderStepped:Wait()
            hrp.Velocity = oldV
        end
    end)

table.insert(connections, flingConnection)

end

local function toggleFling()
    playerState.isWalkFlingActive = not playerState.isWalkFlingActive

    playSound()

    if flingToggle then
        flingToggle.Text = playerState.isWalkFlingActive and "FLINGING..." or "OFF"

        if playerState.isWalkFlingActive then
            flingToggle.BackgroundColor3 = Color3.fromRGB(0,255,0)
        else
            flingToggle.BackgroundColor3 = Color3.fromRGB(0,0,0)
        end
    end

    createNotification(
        "flinging",
        playerState.isWalkFlingActive and "ENABLED" or "DISABLED"
    )
end

