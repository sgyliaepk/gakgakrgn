local function setTarget(player)


    if player then
        if not flingActive then
            targetPlayer = nil
            targetMode = false
            createNotification("Error", "Enable fling first!")
            updateTargetStatusLabel()
            return false
        end

        targetPlayer = player
        targetMode = true
        createNotification("Target Locked", player.Name)
        updateTargetStatusLabel()
        return true
    else
    local wasTargetMode = targetMode

    targetPlayer = nil
    targetMode = false

    createNotification("Target", "Target cleared")

    if wasTargetMode then
        createNotification("Target Mode", "OFF")
    end

    updateTargetStatusLabel()
    return true
  end
end

-- ===== FLING LOGIC =====
local function toggleFling(newState)
    if newState == nil then
        flingActive = not flingActive
    else
        flingActive = newState
    end

    playSound()

    if flingToggleRef then
        flingToggleRef:Set(flingActive)
    end

    updateTargetStatusLabel()

    if flingActive then
        if not flingConnection then
            flingConnection = RunService.PostSimulation:Connect(function()
                if not flingActive then return end
                if not LocalPlayer.Character then return end
                local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        for _, part in pairs(p.Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end

                local shouldFling = false
                if targetMode and targetPlayer then
                    if targetPlayer.Character then
                        local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if tHrp then
                            local dist = (hrp.Position - tHrp.Position).Magnitude
                            if dist <= 20 then shouldFling = true end
                        end
                    end
                else
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character then
                            local tHrp = p.Character:FindFirstChild("HumanoidRootPart")
                            if tHrp then
                                local dist = (hrp.Position - tHrp.Position).Magnitude
                                if dist <= 20 then
                                    shouldFling = true
                                    break
                                end
                            end
                        end
                    end
                end

                if shouldFling then
                    for _, v in pairs(LocalPlayer.Character:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                    local strength = flingPower * 5000
                    local oldV = hrp.Velocity
                    hrp.Velocity = Vector3.new(strength, strength, strength)
                    RunService.RenderStepped:Wait()
                    hrp.Velocity = oldV
                end
            end)
        end
    else
        if flingConnection then
            flingConnection:Disconnect()
            flingConnection = nil
        end
    end
end

