local function teleportToPlayer(playerName)
    if playerName == "" then
        createNotification("Error", "Enter a player name.")
        return
    end

    local target

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Name:lower():sub(1, #playerName) == playerName:lower() then
            target = plr
            break
        end
    end

    if not target then
        createNotification("Error", "Player not found.")
        return
    end

    local myCharacter = LocalPlayer.Character
    local targetCharacter = target.Character

    if not myCharacter or not targetCharacter then
        createNotification("Error", "Character unavailable.")
        return
    end

    local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")

    if not myRoot or not targetRoot then
        createNotification("Error", "HumanoidRootPart missing.")
        return
    end

    -- Teleport slightly behind the player
    myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -3)

    createNotification("Teleported", "Teleported to "..target.Name)
end

--fling hit detection--
local function startFlingProtection()
    if flingProtectionConnection then
        flingProtectionConnection:Disconnect()
    end

    flingProtectionConnection = RunService.Heartbeat:Connect(function()
        if not flingActive then
            return
        end

        if flingProtectionCooldown then
            return
        end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            return
        end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local enemyRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                local hum = plr.Character:FindFirstChild("Humanoid")

                if enemyRoot and hum then
                    if (enemyRoot.Position - myRoot.Position).Magnitude <= 10 then

                        local animator = hum:FindFirstChildOfClass("Animator")
                        if animator then
                            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                                local id = track.Animation.AnimationId:match("%d+")

                                if id and DangerousAnimations[id] then
                                    flingProtectionCooldown = true

                                    toggleFling(false)

                                    task.delay(2.5, function()
                                        toggleFling(true)
                                        flingProtectionCooldown = false
                                    end)

                                    return
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end

---shadow step logic----
local function doBlink()
    if not blinkOn or blinkCooldown then return end

    local character = LocalPlayer.Character
if not character then return end

local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local cam = workspace.CurrentCamera
    local look = cam.CFrame.LookVector
    local dashDir = Vector3.new(look.X, 0, look.Z)

    if dashDir.Magnitude > 0 then
        dashDir = dashDir.Unit
    end

    hrp.CFrame = hrp.CFrame + dashDir * blinkDist

    task.spawn(function()
        local ch = LocalPlayer.Character
        if not ch then return end

        for _, part in ipairs(ch:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local original = part.Material
                part.Material = Enum.Material.Neon

                task.delay(0.12, function()
                    if part and part.Parent then
                        part.Material = original
                    end
                end)
            end
        end
    end)

    blinkCooldown = true
    task.delay(0.2, function()
        blinkCooldown = false
    end)
end

